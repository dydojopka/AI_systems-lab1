<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/dydojopka/ontologies/2026/8/dota2#"
     xml:base="http://www.semanticweb.org/dydojopka/ontologies/2026/8/dota2"
     xmlns:dota2="http://www.semanticweb.org/dydojopka/ontologies/2026/8/dota2#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://www.semanticweb.org/dydojopka/ontologies/2026/8/dota2/core">
        <rdfs:label xml:lang="ru">Базовая онтология Dota 2</rdfs:label>
        <rdfs:comment xml:lang="ru">Общие классы, свойства и ограничения онтологического пространства Dota 2.</rdfs:comment>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>

    <!-- Object properties -->

    <owl:ObjectProperty rdf:about="#controls">
        <owl:inverseOf rdf:resource="#controlledBy"/>
        <rdfs:domain rdf:resource="#Player"/>
        <rdfs:range rdf:resource="#Hero"/>
        <rdfs:label xml:lang="ru">управляет</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#controlledBy">
        <rdfs:domain rdf:resource="#Hero"/>
        <rdfs:range rdf:resource="#Player"/>
        <rdfs:label xml:lang="ru">управляется игроком</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#belongsTo">
        <owl:inverseOf rdf:resource="#hasPlayer"/>
        <rdfs:domain rdf:resource="#Player"/>
        <rdfs:range rdf:resource="#Team"/>
        <rdfs:label xml:lang="ru">принадлежит команде</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasPlayer">
        <rdfs:domain rdf:resource="#Team"/>
        <rdfs:range rdf:resource="#Player"/>
        <rdfs:label xml:lang="ru">содержит игрока</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#participatesIn">
        <owl:inverseOf rdf:resource="#hasParticipant"/>
        <rdfs:domain rdf:resource="#Player"/>
        <rdfs:range rdf:resource="#Match"/>
        <rdfs:label xml:lang="ru">участвует в матче</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasParticipant">
        <rdfs:domain rdf:resource="#Match"/>
        <rdfs:range rdf:resource="#Player"/>
        <rdfs:label xml:lang="ru">имеет участника</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasAbility">
        <owl:inverseOf rdf:resource="#abilityOf"/>
        <rdfs:domain rdf:resource="#Hero"/>
        <rdfs:range rdf:resource="#Ability"/>
        <rdfs:label xml:lang="ru">имеет способность</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#abilityOf">
        <rdfs:domain rdf:resource="#Ability"/>
        <rdfs:range rdf:resource="#Hero"/>
        <rdfs:label xml:lang="ru">способность героя</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#usesItem">
        <owl:inverseOf rdf:resource="#usedBy"/>
        <rdfs:domain rdf:resource="#Hero"/>
        <rdfs:range rdf:resource="#Item"/>
        <rdfs:label xml:lang="ru">использует предмет</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#usedBy">
        <rdfs:domain rdf:resource="#Item"/>
        <rdfs:range rdf:resource="#Hero"/>
        <rdfs:label xml:lang="ru">используется героем</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasRole">
        <owl:inverseOf rdf:resource="#roleOf"/>
        <rdfs:domain rdf:resource="#Hero"/>
        <rdfs:range rdf:resource="#Role"/>
        <rdfs:label xml:lang="ru">имеет роль</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#roleOf">
        <rdfs:domain rdf:resource="#Role"/>
        <rdfs:range rdf:resource="#Hero"/>
        <rdfs:label xml:lang="ru">роль героя</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasResource">
        <rdfs:domain rdf:resource="#Hero"/>
        <rdfs:range rdf:resource="#Resource"/>
        <rdfs:label xml:lang="ru">имеет ресурс</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#takesPlaceOn">
        <owl:inverseOf rdf:resource="#hostsMatch"/>
        <rdfs:domain rdf:resource="#Match"/>
        <rdfs:range rdf:resource="#Map"/>
        <rdfs:label xml:lang="ru">проходит на карте</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hostsMatch">
        <rdfs:domain rdf:resource="#Map"/>
        <rdfs:range rdf:resource="#Match"/>
        <rdfs:label xml:lang="ru">принимает матч</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#attacks">
        <rdfs:domain rdf:resource="#Hero"/>
        <rdfs:range rdf:resource="#Building"/>
        <rdfs:label xml:lang="ru">атакует</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#defends">
        <rdfs:domain rdf:resource="#Team"/>
        <rdfs:range rdf:resource="#Building"/>
        <rdfs:label xml:lang="ru">защищает</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#contains">
        <owl:inverseOf rdf:resource="#containedOnMap"/>
        <rdfs:domain rdf:resource="#Map"/>
        <rdfs:range rdf:resource="#Building"/>
        <rdfs:label xml:lang="ru">содержит сооружение</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#containedOnMap">
        <rdfs:domain rdf:resource="#Building"/>
        <rdfs:range rdf:resource="#Map"/>
        <rdfs:label xml:lang="ru">находится на карте</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#memberOfTeam">
        <owl:inverseOf rdf:resource="#hasHero"/>
        <rdfs:domain rdf:resource="#Hero"/>
        <rdfs:range rdf:resource="#Team"/>
        <rdfs:label xml:lang="ru">герой команды</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasHero">
        <rdfs:domain rdf:resource="#Team"/>
        <rdfs:range rdf:resource="#Hero"/>
        <rdfs:label xml:lang="ru">имеет героя</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasTeam">
        <owl:inverseOf rdf:resource="#competesIn"/>
        <rdfs:domain rdf:resource="#Match"/>
        <rdfs:range rdf:resource="#Team"/>
        <rdfs:label xml:lang="ru">имеет команду</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#competesIn">
        <rdfs:domain rdf:resource="#Team"/>
        <rdfs:range rdf:resource="#Match"/>
        <rdfs:label xml:lang="ru">соревнуется в матче</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#representsFaction">
        <rdfs:domain rdf:resource="#Team"/>
        <rdfs:range rdf:resource="#Faction"/>
        <rdfs:label xml:lang="ru">представляет фракцию</rdfs:label>
    </owl:ObjectProperty>

    <!-- Datatype properties shared by every module -->

    <owl:DatatypeProperty rdf:about="#hasName">
        <rdfs:domain rdf:resource="#Dota2Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="ru">название</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasNickname">
        <rdfs:domain rdf:resource="#Player"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="ru">псевдоним игрока</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#hasDurationMinutes">
        <rdfs:domain rdf:resource="#Match"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="ru">продолжительность в минутах</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Root and main classes -->

    <owl:Class rdf:about="#Dota2Entity">
        <rdfs:label xml:lang="ru">Сущность Dota 2</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Game">
        <rdfs:subClassOf rdf:resource="#Dota2Entity"/>
        <rdfs:label xml:lang="ru">Игра</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Match">
        <rdfs:subClassOf rdf:resource="#Game"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#takesPlaceOn"/>
                <owl:someValuesFrom rdf:resource="#Map"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#takesPlaceOn"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="#Map"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#hasTeam"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="#Team"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="ru">Матч</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#RankedMatch">
        <rdfs:subClassOf rdf:resource="#Match"/>
        <owl:disjointWith rdf:resource="#NormalMatch"/>
        <rdfs:label xml:lang="ru">Рейтинговый матч</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#NormalMatch">
        <rdfs:subClassOf rdf:resource="#Match"/>
        <rdfs:label xml:lang="ru">Обычный матч</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Player">
        <rdfs:subClassOf rdf:resource="#Dota2Entity"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#controls"/><owl:someValuesFrom rdf:resource="#Hero"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#belongsTo"/><owl:someValuesFrom rdf:resource="#Team"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#participatesIn"/><owl:someValuesFrom rdf:resource="#Match"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:label xml:lang="ru">Игрок</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Team"><rdfs:subClassOf rdf:resource="#Dota2Entity"/><rdfs:label xml:lang="ru">Команда</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Faction"><rdfs:subClassOf rdf:resource="#Dota2Entity"/><rdfs:label xml:lang="ru">Фракция</rdfs:label></owl:Class>

    <owl:Class rdf:about="#Hero">
        <rdfs:subClassOf rdf:resource="#Dota2Entity"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasAbility"/><owl:someValuesFrom rdf:resource="#Ability"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#usesItem"/><owl:someValuesFrom rdf:resource="#Item"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#hasRole"/><owl:someValuesFrom rdf:resource="#Role"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:label xml:lang="ru">Герой</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#Ability"><rdfs:subClassOf rdf:resource="#Dota2Entity"/><rdfs:label xml:lang="ru">Способность</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Item"><rdfs:subClassOf rdf:resource="#Dota2Entity"/><rdfs:label xml:lang="ru">Предмет</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Building"><rdfs:subClassOf rdf:resource="#Dota2Entity"/><rdfs:label xml:lang="ru">Сооружение</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Resource"><rdfs:subClassOf rdf:resource="#Dota2Entity"/><rdfs:label xml:lang="ru">Ресурс</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Map"><rdfs:subClassOf rdf:resource="#Dota2Entity"/><rdfs:label xml:lang="ru">Карта</rdfs:label></owl:Class>
    <owl:Class rdf:about="#MapRegion"><rdfs:subClassOf rdf:resource="#Dota2Entity"/><rdfs:label xml:lang="ru">Область карты</rdfs:label></owl:Class>
    <owl:Class rdf:about="#Role"><rdfs:subClassOf rdf:resource="#Dota2Entity"/><rdfs:label xml:lang="ru">Игровая роль</rdfs:label></owl:Class>

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="#Player"/>
            <rdf:Description rdf:about="#Team"/>
            <rdf:Description rdf:about="#Faction"/>
            <rdf:Description rdf:about="#Hero"/>
            <rdf:Description rdf:about="#Ability"/>
            <rdf:Description rdf:about="#Item"/>
            <rdf:Description rdf:about="#Building"/>
            <rdf:Description rdf:about="#Resource"/>
            <rdf:Description rdf:about="#Map"/>
            <rdf:Description rdf:about="#MapRegion"/>
            <rdf:Description rdf:about="#Role"/>
        </owl:members>
    </owl:AllDisjointClasses>
</rdf:RDF>
